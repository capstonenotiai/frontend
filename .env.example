# ─────────────────────────────────────────────────────────────
# NotiAI 프론트엔드 환경변수 예시
# 복사해서 .env.local 로 사용하세요. (.env* 파일은 git에 올라가지 않습니다)
#
# ⚠️ VITE_ 로 시작하는 값은 빌드 결과물(브라우저)에 그대로 노출됩니다.
#    API Key, OAuth Secret, LLM Key 등 비밀값은 절대 여기에 넣지 마세요.
#    비밀값은 반드시 백엔드 서버에서만 관리합니다.
# ─────────────────────────────────────────────────────────────

# true(기본값): mock 데이터 사용 / false: 실제 백엔드 API 호출
VITE_USE_MOCK=true

# 백엔드 API 주소 (예: https://api.notiai.example.com). 비워두면 같은 origin 의 /api/* 호출
VITE_API_BASE_URL=

# mock 모드에서 "오늘"로 취급할 날짜 (D-day 계산 기준). 실제 API 모드에서는 무시되고 실제 오늘 날짜 사용
VITE_MOCK_TODAY=2026-05-19
